//| mill-version: 1.0.0-RC1-jvm

package build
import mill.*, javalib.*, publish.*
import mill.scalalib.WithJvmWorker
import mill.util.BuildInfo.{millVersion, millBinPlatform}

//n.b. this buildscript is not very idiomatic mill
//mill permits omitting `override` and type definitions, for example
//but i like them :)

def theScalaVersion = "3.7.0"

//java 8 toolchain (TODO: bring it back? maybe we can leave java 8 in the dust)
//object Java8 extends JvmWorkerModule {
//  override def jvmId = "temurin:8.0-442"
//} //bagsdb

//todo upstream? ;)
def codeberg(owner: String, repo: String, tag: Option[String] = None): VersionControl = VersionControl(
  browsableRepository = Some(s"https://codeberg.org/$owner/$repo"),
  connection = Some(VersionControlConnection.gitGit("codeberg.org", s"$owner/$repo")),
  developerConnection = Some(VersionControlConnection.gitSsh(
    "codeberg.org",
    s":$owner/$repo.git",
    username = Some("git")
  )),
  tag = tag
)

trait ToyboxBaseModule extends PublishModule with WithJvmWorker {
  def googleGson = mvn"com.google.code.gson:gson:2.11.0"
  def jetbrainsAnnotations = mvn"org.jetbrains:annotations:26.0.2"
  def mappingio = mvn"net.fabricmc:mapping-io:0.7.1" //it can be found on maven central as well

  //toolchain
//  override def jvmWorker: ModuleRef[JvmWorkerModule] = ModuleRef(Java8)

  //require each project to set a description
  def desc : String

  //publishing
  override def publishVersion = "0.0.1"
  private def vc: VersionControl = codeberg("CrackedPolishedBlackstoneBricksMC", "toybox")
  override def pomSettings: T[PomSettings] = PomSettings (
    description = desc + " Part of Toybox.",
    organization = "agency.highlysuspect",
    licenses = Seq(), //ARR for now
    versionControl = vc,
    url = vc.browsableRepository.get,
    developers = Seq(Developer("quat", "quat", "https://highlysuspect.agency")),
  )
}

trait ToyboxModule extends JavaModule with ToyboxBaseModule { outer =>
  //global deps
  override def compileMvnDeps: T[Seq[Dep]] = Seq(jetbrainsAnnotations)

  //for test modules
  trait ToyboxTests extends JavaTests with TestModule.Junit5 {}

  //iunno what im doing https://mill-build.org/mill/extending/writing-plugins.html
  trait WithMillModule extends scalalib.ScalaModule with ToyboxBaseModule {
    override def desc: String = s"Utilities for using ${outer.artifactName} with the Mill build system."

    override def scalaVersion = theScalaVersion
    override def platformSuffix: T[String] = s"_mill$millBinPlatform"
    override def mvnDeps = Seq(mvn"com.lihaoyi::mill-libs:$millVersion")

    override def moduleDeps: Seq[PublishModule] = super.moduleDeps ++ Seq(outer)
  }
}

/// utils ///

object `toybox-checksum` extends ToyboxModule {
  override def desc: String = "Utilities for working with checksums and hashes."
}

object `toybox-download` extends ToyboxModule {
  override def desc: String = "Utilities for downloading files from the internet."
  object test extends ToyboxTests {}
  object mill extends WithMillModule {}
}

object `toybox-string` extends ToyboxModule {
  override def desc: String = "Misc string utilities."
  object test extends ToyboxTests {}
}

object `toybox-gson` extends ToyboxModule {
  override def desc: String = "General utilities for working with GSON on Toybox types."
  override def mvnDeps: T[Seq[Dep]] = super.mvnDeps() ++ Seq(googleGson)
  object test extends ToyboxTests {}
}

/// main products ///

object `toybox-gdiff` extends ToyboxModule {
  override def desc: String = "Implementation of the Generic Diff Algorithm used by Minecraft Forge."
}

object `toybox-manifest-index` extends ToyboxModule {
  override def desc: String = "Utilities for parsing version_manifest_v2.json from piston-meta."
  override def moduleDeps: Seq[PublishModule] = super.moduleDeps ++ Seq(`toybox-gson`)
  object test extends ToyboxTests {}

  object mill extends WithMillModule {}
}

object `toybox-mapping` extends ToyboxModule {
  override def desc: String = "Interchange types for mappings."
}

object `toybox-mapping-mappingio` extends ToyboxModule {
  override def desc: String = "toybox-mapping interop with FabricMC Mapping-IO."
  override def moduleDeps: Seq[PublishModule] = super.moduleDeps ++ Seq(`toybox-mapping`)
  override def mvnDeps: T[Seq[Dep]] = super.mvnDeps() ++ Seq(mappingio)
}

object `toybox-mapping-mcp` extends ToyboxModule {
  override def desc: String = "toybox-mapping utilities for (old) MCP mapping formats."
  override def moduleDeps: Seq[PublishModule] = super.moduleDeps ++ Seq(`toybox-mapping`, `toybox-string`)
}

object `toybox-version-manifest` extends ToyboxModule {
  override def desc: String = "Utilities for parsing per-version manifest indices from piston-meta."
  override def moduleDeps: Seq[PublishModule] = super.moduleDeps ++ Seq(`toybox-gson`)
}

/// northstar ///

object northstar extends scalalib.ScalaModule {
  override def scalaVersion = theScalaVersion
  override def platformSuffix: T[String] = s"_mill$millBinPlatform"
  override def mvnDeps = Seq(mvn"com.lihaoyi::mill-libs:$millVersion")

  override def moduleDeps = super.moduleDeps ++ Seq(
    `toybox-manifest-index`, `toybox-download`.mill
  )

  object test extends ScalaTests with TestModule.Utest {
    override def mvnDeps = Seq(mvn"com.lihaoyi::mill-testkit:$millVersion")
    override def forkEnv = Task {
      val localClasspathString = northstar.localClasspath().map(_.path).mkString("\n")
      Map(
        "MILL_EXECUTABLE_PATH" -> millExecutable.assembly().path.toString,
        //TODO i dont think this works
        "MILL_LOCAL_TEST_OVERRIDE_northstar" -> localClasspathString
      )
    }

    object millExecutable extends JavaModule {
      override def mvnDeps = Seq(mvn"com.lihaoyi:mill-runner-launcher_3:$millVersion")
      override def mainClass = Some("mill.launcher.MillLauncherMain")
    }
  }
}