package build
import mill._
import mill.define.ModuleRef
import mill.main.BuildInfo.millVersion
import javalib._
import mill.scalalib.WithZincWorker
import publish._

//java 8 toolchain
object Java8 extends ZincWorkerModule {
  override def jvmId = "temurin:8.0-442"
}

trait ToyboxBaseModule extends PublishModule with WithZincWorker {
  def googleGson = ivy"com.google.code.gson:gson:2.11.0"
  def jetbrainsAnnotations = ivy"org.jetbrains:annotations:26.0.2"
  def mappingio = ivy"net.fabricmc:mapping-io:0.7.1" //it can be found on maven central as well

  //toolchain
  override def zincWorker: ModuleRef[ZincWorkerModule] = ModuleRef(Java8)

  //require each project to set a description
  def desc : String

  //publishing
  override def publishVersion = "0.0.1"
  private def vc: VersionControl = VersionControl.github("CrackedPolishedBlackstoneBricksMC", "toybox")
  override def pomSettings: T[PomSettings] = PomSettings (
    description = desc + " Part of Toybox.",
    organization = "agency.highlysuspect",
    licenses = Seq(), //ARR for now
    versionControl = vc,
    url = vc.browsableRepository.get,
    developers = Seq(Developer("quat", "quat", "https://highlysuspect.agency")),
  )
}

trait ToyboxModule extends JavaModule with ToyboxBaseModule { outer =>
  //global deps
  override def compileIvyDeps: T[Agg[Dep]] = Agg(jetbrainsAnnotations)

  //for test modules
  trait ToyboxTests extends JavaTests with TestModule.Junit5 {}

  trait WithGsonModule extends ToyboxModule {
    override def desc: String = s"Utilities for connecting Google GSON to ${outer.artifactName}."
    override def ivyDeps: T[Agg[Dep]] = super.ivyDeps() ++ Agg(googleGson)
    //automagically include toybox-gson and the enclosing module
    //"outer" isn't magic, it's some kind of implicit argument thing defined up there (scala is weird!)
    override def moduleDeps: Seq[PublishModule] = super.moduleDeps ++ Seq(`toybox-gson`, outer)
  }

  //iunno what im doing https://mill-build.org/mill/extending/writing-plugins.html
  trait WithMillModule extends scalalib.ScalaModule with ToyboxBaseModule {
    override def desc: String = s"Utilities for using ${outer.artifactName} with the Mill build system."

    def scalaVersion = "2.13.15"

    //Set the `platformSuffix` so the name indicates what Mill version it is compiled for
    override def platformSuffix: T[String] = "_mill" + mill.main.BuildInfo.millBinPlatform

    override def ivyDeps = Agg(ivy"com.lihaoyi:mill-dist:$millVersion") //compile against current mill version

    override def moduleDeps: Seq[PublishModule] = super.moduleDeps ++ Seq(outer)
  }
}

/// utils ///

object `toybox-checksum` extends ToyboxModule {
  override def desc: String = "Utilities for working with checksums and hashes."
}

object `toybox-string` extends ToyboxModule {
  override def desc: String = "Misc string utilities."
  object test extends ToyboxTests {}
}

object `toybox-gson` extends ToyboxModule {
  override def desc: String = "General utilities for working with GSON on Toybox types."
  override def ivyDeps: T[Agg[Dep]] = super.ivyDeps() ++ Agg(googleGson)
  object test extends ToyboxTests {}
}

/// main products ///

object `toybox-gdiff` extends ToyboxModule {
  override def desc: String = "Implementation of the Generic Diff Algorithm used by Minecraft Forge."
}

object `toybox-manifest-index` extends ToyboxModule {
  override def desc: String = "Utilities for parsing version_manifest_v2.json from piston-meta."
  override def ivyDeps: T[Agg[Dep]] = super.ivyDeps() ++ Agg(googleGson)
  object test extends ToyboxTests {}

  object gson extends WithGsonModule {
    object test extends ToyboxTests {
      //reach across and include the test classes from toybox-manifest-index.test as well
      override def moduleDeps: Seq[JavaModule] = super.moduleDeps ++ Seq(`toybox-manifest-index`.test)
    }
  }

  object mill extends WithMillModule {
    override def moduleDeps: Seq[PublishModule] = super.moduleDeps ++ Seq(gson)
  }
}

object `toybox-mapping` extends ToyboxModule {
  override def desc: String = "Interchange types for mappings."
}

object `toybox-mapping-mappingio` extends ToyboxModule {
  override def desc: String = "toybox-mapping interop with FabricMC Mapping-IO."
  override def moduleDeps: Seq[PublishModule] = super.moduleDeps ++ Seq(`toybox-mapping`)
  override def ivyDeps: T[Agg[Dep]] = super.ivyDeps() ++ Agg(mappingio)
}

object `toybox-mapping-mcp` extends ToyboxModule {
  override def desc: String = "toybox-mapping utilities for (old) MCP mapping formats."
  override def moduleDeps: Seq[PublishModule] = super.moduleDeps ++ Seq(`toybox-mapping`, `toybox-string`)
}

object `toybox-version-manifest` extends ToyboxModule {
  override def desc: String = "Utilities for parsing per-version manifest indices from piston-meta."
  override def ivyDeps: T[Agg[Dep]] = super.ivyDeps() ++ Agg(googleGson)

  object gson extends WithGsonModule {
  }
}

/// northstar ///

object northstar extends scalalib.ScalaModule {
  def scalaVersion = "2.13.15"

  //Set the `platformSuffix` so the name indicates what Mill version it is compiled for
  override def platformSuffix: T[String] = "_mill" + mill.main.BuildInfo.millBinPlatform

  override def ivyDeps = Agg(ivy"com.lihaoyi:mill-dist:$millVersion") //compile against current mill version

  override def moduleDeps = super.moduleDeps ++ Seq(
    `toybox-manifest-index`.gson
  )

  object test extends ScalaTests with TestModule.Utest {
    override def ivyDeps = Agg(ivy"com.lihaoyi::mill-testkit:$millVersion")
    //override def forkEnv = Map("MILL_EXECUTABLE_PATH" -> millExecutable.assembly().path.toString)

    object millExecutable extends JavaModule {
      override def ivyDeps = Agg(ivy"com.lihaoyi:mill-dist:$millVersion")

      override def mainClass = Some("mill.runner.client.MillClientMain")

      override def resources = Task {
        val p = Task.dest / "mill/local-test-overrides" / s"com.lihaoyi-${northstar.artifactId()}"
        os.write(p, northstar.localClasspath().map(_.path).mkString("\n"), createFolders = true)
        Seq(PathRef(Task.dest))
      }
    }
  }
}