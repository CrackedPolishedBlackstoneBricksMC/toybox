package build
import mill._
import mill.define.ModuleRef
import javalib._
import publish._

//java 8 toolchain
object Java8 extends ZincWorkerModule {
  override def jvmId = "temurin:8.0-442"
}

//MavenModule is like JavaModule but defaults the source dir to src/main/java instead of src/.
//TODO migrate off that.
trait ToyboxModule extends MavenModule with PublishModule {
  def gson = ivy"com.google.code.gson:gson:2.11.0"
  def jetbrainsAnnotations = ivy"org.jetbrains:annotations:26.0.2"
  def mappingio = ivy"net.fabricmc:mapping-io:0.7.1" //it can be found on maven central as well

  //require each project to set a description
  def desc : String

  //toolchain
  override def zincWorker: ModuleRef[ZincWorkerModule] = ModuleRef(Java8)

  //global deps
  override def compileIvyDeps: T[Agg[Dep]] = Agg(jetbrainsAnnotations)

  //publishing
  override def publishVersion = "0.0.1"
  private def vc: VersionControl = VersionControl.github("CrackedPolishedBlackstoneBricksMC", "toybox")
  override def pomSettings: T[PomSettings] = PomSettings (
    description = desc + " Part of Toybox.",
    organization = "agency.highlysuspect",
    licenses = Seq(), //ARR for now
    versionControl = vc,
    url = vc.browsableRepository.get,
    developers = Seq(Developer("quat", "quat", "https://highlysuspect.agency")),
  )

  //rah rah, the default assembly task builds to "out.jar" and can't be changed
  //but you know what? just subclass it
  override def assembly: T[PathRef] = Task {
    val renamed = Task.dest / s"${artifactId()}-${publishVersion()}.jar"
    os.move(super.assembly().path, renamed)
    PathRef(renamed)
  }

  //for test modules
  trait ToyboxTests extends MavenTests with TestModule.Junit5 {}
}

/// utils ///

object `toybox-checksum` extends ToyboxModule {
  override def desc: String = "Utilities for working with checksums and hashes."
}

object `toybox-string` extends ToyboxModule {
  override def desc: String = "Misc string utilities."

  object test extends ToyboxTests {}
}

/// main products ///

object `toybox-gdiff` extends ToyboxModule {
  override def desc: String = "Implementation of the Generic Diff Algorithm used by Minecraft Forge."
}

object `toybox-manifest-index` extends ToyboxModule {
  override def desc: String = "Utilities for parsing version_manifest_v2.json from piston-meta."
  override def ivyDeps: T[Agg[Dep]] = super.ivyDeps() ++ Agg(gson)
}

object `toybox-mapping` extends ToyboxModule {
  override def desc: String = "Interchange types for mappings."
}

object `toybox-mapping-mappingio` extends ToyboxModule {
  override def desc: String = "toybox-mapping interop with FabricMC Mapping-IO."
  override def moduleDeps: Seq[PublishModule] = Seq(`toybox-mapping`)
  override def ivyDeps: T[Agg[Dep]] = super.ivyDeps() ++ Agg(mappingio)
}

object `toybox-mapping-mcp` extends ToyboxModule {
  override def desc: String = "toybox-mapping utilities for (old) MCP mapping formats."
  override def moduleDeps: Seq[PublishModule] = Seq(`toybox-mapping`, `toybox-string`)
}

object `toybox-version-manifest` extends ToyboxModule {
  override def desc: String = "Utilities for parsing per-version manifest indices from piston-meta."
  override def ivyDeps: T[Agg[Dep]] = super.ivyDeps() ++ Agg(gson)
}
